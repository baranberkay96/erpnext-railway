; Rendered at boot by railway-entrypoint.sh (envsubst). Every Frappe process of the
; upstream compose (backend, websocket, queue-short, queue-long, scheduler, frontend)
; runs here as the `frappe` user, sharing the single `sites` volume.

[supervisord]
nodaemon=true
user=root
logfile=/dev/null
logfile_maxbytes=0
pidfile=/tmp/supervisord.pid

[unix_http_server]
file=/tmp/supervisor.sock
chmod=0700

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix:///tmp/supervisor.sock

; Gunicorn (official start.sh; GUNICORN_WORKERS / GUNICORN_THREADS / GUNICORN_TIMEOUT from env)
[program:backend]
command=/usr/local/bin/start.sh
directory=/home/frappe/frappe-bench
user=frappe
environment=HOME="/home/frappe"
priority=10
autorestart=true
stopasgroup=true
killasgroup=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
redirect_stderr=true

; Realtime (socket.io) on 127.0.0.1:9000
[program:websocket]
command=node /home/frappe/frappe-bench/apps/frappe/socketio.js
directory=/home/frappe/frappe-bench
user=frappe
environment=HOME="/home/frappe"
priority=10
autorestart=true
stopasgroup=true
killasgroup=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
redirect_stderr=true

; Background jobs: short + default queues
[program:queue-short]
command=bench worker --queue short,default
process_name=%(program_name)s-%(process_num)d
numprocs=${WORKER_SHORT_PROCS}
directory=/home/frappe/frappe-bench
user=frappe
environment=HOME="/home/frappe"
priority=20
autorestart=true
stopwaitsecs=360
stopasgroup=true
killasgroup=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
redirect_stderr=true

; Background jobs: long-running queue (also drains default/short when idle)
[program:queue-long]
command=bench worker --queue long,default,short
process_name=%(program_name)s-%(process_num)d
numprocs=${WORKER_LONG_PROCS}
directory=/home/frappe/frappe-bench
user=frappe
environment=HOME="/home/frappe"
priority=20
autorestart=true
stopwaitsecs=1560
stopasgroup=true
killasgroup=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
redirect_stderr=true

; Scheduler (enqueues cron-style jobs)
[program:scheduler]
command=bench schedule
directory=/home/frappe/frappe-bench
user=frappe
environment=HOME="/home/frappe"
priority=20
autorestart=true
stopasgroup=true
killasgroup=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
redirect_stderr=true

; If any program keeps crashing (FATAL), stop the container so Railway restarts it
; instead of leaving a half-working instance behind a passing healthcheck.
[eventlistener:fatal-exit]
command=/usr/local/bin/supervisor-fatal-exit.sh
events=PROCESS_STATE_FATAL
user=root
stdout_logfile=/dev/null
stderr_logfile=/dev/stdout
stderr_logfile_maxbytes=0

; Frontend: official nginx template (static assets, /socket.io, proxy to gunicorn)
[program:frontend]
command=/usr/local/bin/nginx-entrypoint.sh
directory=/home/frappe/frappe-bench
; nginx master runs as root (to write to supervisord's log pipes); workers run as frappe (nginx.conf `user`).
user=root
environment=BACKEND="127.0.0.1:8000",SOCKETIO="127.0.0.1:9000",NGINX_LISTEN_PORT="${PORT}",FRAPPE_SITE_NAME_HEADER="${SITE_NAME}",UPSTREAM_REAL_IP_ADDRESS="0.0.0.0/0",UPSTREAM_REAL_IP_HEADER="X-Forwarded-For",UPSTREAM_REAL_IP_RECURSIVE="off",PROXY_READ_TIMEOUT="${PROXY_READ_TIMEOUT}",CLIENT_MAX_BODY_SIZE="${CLIENT_MAX_BODY_SIZE}"
priority=30
autorestart=true
stopasgroup=true
killasgroup=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
redirect_stderr=true
